#!/bin/sh
set -e

# Enablement is removed in prerm while the unit file still exists. After
# unpack/removal, refresh the running manager's view of the unit files.
case "$1" in
  remove|purge|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
    fi
    ;;
esac

exit 0
