{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "separateMultipleMajor": true,
  "packageRules": [
    {
      "description": "Keep release binaries on Ubuntu 24.04 for Debian 13 glibc compatibility",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/release-binary.yml"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "24.04"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep pinned Python CLI tools in GitHub Actions current",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "ruff==(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "ruff",
      "datasourceTemplate": "pypi"
    }
  ]
}
