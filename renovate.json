{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "separateMultipleMajor": true,
  "packageRules": [
    {
      "description": "Keep release binaries on Ubuntu 24.04 for Debian 13 glibc compatibility",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/release-binary.yml"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "24.04"
    },
    {
      "description": "Keep stable compiler pins synchronized; review compiler updates",
      "matchDatasources": [
        "rust-version"
      ],
      "matchDepNames": [
        "rust"
      ],
      "matchCurrentVersion": "/^\\d+\\.\\d+\\.\\d+$/",
      "groupName": "Rust compiler",
      "groupSlug": "rust-compiler",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep pinned Python CLI tools in GitHub Actions current",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "ruff==(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "ruff",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Track stable Rust inputs in shared CI workflows",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*rust-toolchain:[ \\t]*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "rust",
      "datasourceTemplate": "rust-version",
      "versioningTemplate": "rust-release-channel"
    }
  ]
}
