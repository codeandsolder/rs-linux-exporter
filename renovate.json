{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "separateMultipleMajor": true,
  "packageRules": [
    {
      "description": "Keep release binaries on Ubuntu 24.04 for Debian 13 glibc compatibility",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/release-binary.yml"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "24.04"
    },
    {
      "description": "BTLS native identity is dictated by the Wreq revision pinned by lurkmoar; update direct BTLS pins together with that dependency chain, not to independent BTLS main",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "/^https:\\/\\/github\\.com\\/codeandsolder\\/btls-fast(?:\\.git)?$/"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "enabled": false
    }
  ]
}
